# =============================================================================
# Producción (VPS) — copiar a .env.production en la RAÍZ del repo y rellenar.
# El compose lo lee con:
#   docker compose --env-file .env.production -f infrastructure/docker/docker-compose.prod.yml up -d --build
# Los marcados [SECRETO] hay que generarlos — nunca dejar los de ejemplo.
# =============================================================================

# --- Dominio del API (Caddy emite el certificado para este host) ---
# El registro DNS A debe apuntar a la IP del VPS ANTES de levantar.
API_DOMAIN=api.eliteforge.app

# --- Postgres (red interna del compose; no se publica al host) ---
POSTGRES_USER=ef_user
# [SECRETO] Generar: openssl rand -base64 24
POSTGRES_PASSWORD=
POSTGRES_DB=ef_db

# --- Autenticación ---
# [SECRETO] Generar: openssl rand -base64 48
JWT_SECRET=

# --- CORS: orígenes del frontend web, separados por coma ---
CORS_ORIGINS=https://eliteforge.app,https://www.eliteforge.app

# --- Push (opcional, hoy sin uso en código — ver apps/backend/.env.example) ---
EXPO_ACCESS_TOKEN=

# =============================================================================
# Producción (VPS) — copiar a .env.production en la RAÍZ del repo y rellenar.
# El compose lo lee con:
#   docker compose --env-file .env.production -f infrastructure/docker/docker-compose.prod.yml up -d --build
# Los marcados [SECRETO] hay que generarlos — nunca dejar los de ejemplo.
# =============================================================================

# --- Dominio del API (Caddy emite el certificado para este host) ---
# El registro DNS A debe apuntar a la IP del VPS ANTES de levantar.
API_DOMAIN=api.eliteforge.tech

# --- Dominios de la web (Fase W.5: la web corre en este mismo compose) ---
# Son DOS variables a propósito:
#  - WEB_DOMAIN: la lista completa (con www) separada por ESPACIOS — Caddy la
#    usa como direcciones del mismo bloque para emitir ambos certificados.
#  - WEB_DOMAIN_PRIMARY: UN solo dominio canónico sin protocolo — el build de
#    la web lo usa para armar NEXT_PUBLIC_SITE_URL (https://...), que Next
#    incrusta en el bundle en tiempo de compilación.
WEB_DOMAIN=eliteforge.tech www.eliteforge.tech
WEB_DOMAIN_PRIMARY=eliteforge.tech

# --- Postgres (red interna del compose; no se publica al host) ---
POSTGRES_USER=ef_user
# [SECRETO] Generar: openssl rand -base64 24
POSTGRES_PASSWORD=
POSTGRES_DB=ef_db

# --- Autenticación ---
# [SECRETO] Generar: openssl rand -base64 48
JWT_SECRET=

# --- CORS: orígenes del frontend web, separados por coma ---
CORS_ORIGINS=https://eliteforge.tech,https://www.eliteforge.tech

# --- Push (opcional, hoy sin uso en código — ver apps/backend/.env.example) ---
EXPO_ACCESS_TOKEN=

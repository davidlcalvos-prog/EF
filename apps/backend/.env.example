# =============================================================================
# Backend Elite Forge — desarrollo local (copiar a apps/backend/.env)
# Todas las variables que leen los 4 microservicios (relevadas por grep en D.0).
# =============================================================================

# --- Base de datos (Prisma la lee de DATABASE_URL; si falta, se arma con POSTGRES_*) ---
# Postgres del compose de dev expone 5433 en el host.
DATABASE_URL=postgresql://ef_user:ef_password@localhost:5433/ef_db?schema=public
# Fallback legacy si no hay DATABASE_URL (resolve-database-url.ts):
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=ef_user
POSTGRES_PASSWORD=ef_password
POSTGRES_DB=ef_db

# --- Autenticación ---
# Secreto de firma de JWT (auth-service y api-gateway DEBEN compartirlo).
# La expiración está fija en código ('7d', auth-service/app.module.ts) — no hay variable.
JWT_SECRET=ef-dev-secret-change-in-production

# --- Hosts/puertos TCP de los microservicios (gateway -> servicios) ---
AUTH_SERVICE_HOST=localhost
AUTH_SERVICE_PORT=3001
USERS_SERVICE_HOST=localhost
USERS_SERVICE_PORT=3002
VENUES_SERVICE_HOST=localhost
VENUES_SERVICE_PORT=3003

# --- API Gateway ---
API_GATEWAY_PORT=3000
# Orígenes permitidos para CORS, separados por coma. Vacío en dev = defaults
# locales (localhost:5175 web + localhost:3000) — ver resolveCorsOrigins en main.ts.
CORS_ORIGINS=

# --- Push (opcional) ---
# expo-server-sdk funciona sin token para volúmenes bajos. Si Expo te exige uno
# (rate limits), habría que pasarlo a new Expo({ accessToken }) — hoy el código
# NO lo lee; se deja documentado para ese momento.
# EXPO_ACCESS_TOKEN=

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Role {
  id          Int     @id @default(autoincrement())
  name        String  @unique
  description String?

  users User[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("roles")
}

model User {
  id           String  @id @default(uuid()) @db.Uuid
  firstname    String
  lastname     String
  email        String  @unique
  passwordHash String
  estado       Boolean @default(true)

  roleId Int
  role   Role @relation(fields: [roleId], references: [id])

  profile                 Profile?
  ownedVenues             Venue[]              @relation("VenueOwner")
  reservations            Reservation[]        @relation("ReservationUser")
  playerStats             PlayerStats?
  physicalTestResults     PhysicalTestResult[]
  psychAssessments        PsychAssessment[]
  createdGroups           Group[]              @relation("GroupCreator")
  groupMemberships        GroupMembership[]
  createdMatches          Match[]              @relation("MatchCreator")
  matchParticipations     MatchParticipant[]
  posts                   Post[]               @relation("PostAuthor")
  postLikes               PostLike[]           @relation("PostLikeUser")
  postComments            PostComment[]        @relation("PostCommentAuthor")
  pushTokens              PushToken[]
  ownedTournaments        Tournament[]         @relation("TournamentOwner")
  tournamentRosterEntries TournamentPlayer[]
  preferences             UserPreferences?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

/**
 * Preferencias de usuario (Fase D.0) — migrado desde MongoDB, que se elimina:
 * era la única colección y no justificaba una segunda base en producción.
 * Ni mobile ni web consumen este endpoint todavía, no hubo datos que migrar.
 */
model UserPreferences {
  id            String  @id @default(uuid()) @db.Uuid
  userId        String  @unique @db.Uuid
  user          User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  theme         String  @default("light")
  language      String  @default("es")
  notifications Boolean @default(true)
  metadata      Json    @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("user_preferences")
}

model Profile {
  id     String @id @default(uuid()) @db.Uuid
  userId String @unique @db.Uuid
  user   User   @relation(fields: [userId], references: [id])

  alias     String    @unique
  birthDate DateTime?

  height Float?
  weight Float?

  /**
   * Una de las 8 posiciones de `PlayerPositionId` (mobile: suggestPlayerPosition.ts). Elegida por el jugador, distinta de la sugerida.
   */
  favoritePosition String?

  /**
   * Avatar del jugador en base64 (mismo esquema que Group.photoBase64 — sin storage real todavía).
   */
  avatarBase64 String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("profiles")
}

/**
 * Snapshot vigente de las 6 estadísticas del jugador (mobile: mockPlayerProfile.ts StatKey).
 * Se recalcula al guardar cada PhysicalTestResult.
 */
model PlayerStats {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  attack    Int      @default(0)
  defense   Int      @default(0)
  endurance Int      @default(0)
  speed     Int      @default(0)
  passes    Int      @default(0)
  dribbling Int      @default(0)
  updatedAt DateTime @updatedAt

  @@map("player_stats")
}

/**
 * Historial de resultados de tests físicos (uno por mes calendario por testId, aplicado server-side).
 * testId ∈ 'attackShots16m' | 'defenseControl' | 'beepTest' | 'sprint30m' | 'loughboroughPass' | 'illinoisAgility'.
 */
model PhysicalTestResult {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  testId      String
  rawData     Json
  score       Int
  completedAt DateTime @default(now())

  @@index([userId, testId])
  @@map("physical_test_results")
}

/**
 * Historial de evaluaciones psicológicas (mobile: psychologicalTest.ts).
 * traits: Record<PsychTraitKey, number> (organizer, directness, discipline, creativity, competitiveness).
 */
model PsychAssessment {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @db.Uuid
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  answers       Json
  teamworkScore Int
  onFieldScore  Int
  overallScore  Int
  traits        Json
  completedAt   DateTime @default(now())

  @@index([userId])
  @@map("psych_assessments")
}

enum ReservationStatus {
  pending
  confirmed
  cancelled
}

enum VenueSurfaceType {
  natural_grass
  synthetic_grass
  dirt_gravel
  futsal_concrete
}

model Venue {
  id                        String            @id @default(uuid()) @db.Uuid
  ownerId                   String            @db.Uuid
  owner                     User              @relation("VenueOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  name                      String
  address                   String?
  pricePerHourCents         Int               @default(0)
  availability              Json              @default("{}")
  /// Fase 7.2: null en canchas ya registradas (no hay migracion de datos existentes,
  /// el owner lo completa desde "Mi cancha" cuando quiera). Solo synthetic_grass es
  /// elegible para el pool aleatorio de Copa Elite Forge.
  surfaceType               VenueSurfaceType?
  reservations              Reservation[]
  tournaments               Tournament[]
  /// Partidos de Copa Elite Forge (kind=elite_forge) asignados a esta cancha al azar.
  assignedTournamentMatches TournamentMatch[] @relation("TournamentMatchVenue")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
  @@map("venues")
}

model Reservation {
  id                String            @id @default(uuid()) @db.Uuid
  userId            String            @db.Uuid
  user              User              @relation("ReservationUser", fields: [userId], references: [id], onDelete: Cascade)
  venueId           String?           @db.Uuid
  venue             Venue?            @relation(fields: [venueId], references: [id], onDelete: SetNull)
  venueName         String
  startsAt          DateTime
  endsAt            DateTime
  status            ReservationStatus @default(pending)
  notes             String?
  /// Vincula la reserva con el partido que la origina (Fase 4). Opcional: se puede reservar sin partido.
  matchId           String?           @unique @db.Uuid
  match             Match?            @relation(fields: [matchId], references: [id], onDelete: SetNull)
  /// Vincula la reserva con el partido de torneo que la generó (Fase 7.1). Opcional.
  tournamentMatchId String?           @unique @db.Uuid
  tournamentMatch   TournamentMatch?  @relation(fields: [tournamentMatchId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([venueId])
  @@index([userId])
  @@map("reservations")
}

/**
 * Torneos privados de un dueño de cancha (Fase 7.1 del roadmap — "Campeonatos
 * Web"). Distinto de los torneos oficiales de Elite Forge (Fase 7.2, mobile):
 * acá el organizador es el propio Empresario, sobre sus clientes/equipos, sin
 * relación con Elite Forge como organizador.
 */
enum TournamentKind {
  /// Fase 7.1 — dueño de cancha, jugadores de nombre libre, una cancha fija.
  private
  /// Fase 7.2 — Elite Forge, equipos = grupos reales, cancha asignada por partido.
  elite_forge
}

model Tournament {
  id                String              @id @default(uuid()) @db.Uuid
  ownerId           String              @db.Uuid
  owner             User                @relation("TournamentOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  kind              TournamentKind      @default(private)
  /// Obligatoria para kind=private (la cancha fija del dueño, igual que en la 7.1).
  /// Null para kind=elite_forge (la cancha se decide por partido, ver TournamentMatch.venueId).
  venueId           String?             @db.Uuid
  venue             Venue?              @relation(fields: [venueId], references: [id], onDelete: Cascade)
  name              String
  courtSize         TournamentCourtSize
  format            TournamentFormat
  maxTeams          Int
  bracketKeys       Int
  extraRoundEnabled Boolean             @default(false)
  status            TournamentStatus    @default(registration)
  /// ScheduleConfig tal cual (weekdays/startHour/endHour/matchDurationHours/courtsPerSlot).
  schedule          Json
  teams             TournamentTeam[]
  matches           TournamentMatch[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
  @@index([venueId])
  @@map("tournaments")
}

model TournamentTeam {
  id              String             @id @default(uuid()) @db.Uuid
  tournamentId    String             @db.Uuid
  tournament      Tournament         @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  name            String
  /// Etiqueta de grupo del FIXTURE (ej. "GA") — nada que ver con el modelo Group real.
  groupId         String?
  /// Solo para kind=elite_forge: el Group real que se inscribio. Nombrado distinto
  /// de `groupId` (arriba, que es la etiqueta de fixture "GA"/"GB") para no chocar
  /// con ese campo ya existente de la Fase 7.1.
  enrolledGroupId String?            @db.Uuid
  enrolledGroup   Group?             @relation(fields: [enrolledGroupId], references: [id], onDelete: Cascade)
  wins            Int                @default(0)
  draws           Int                @default(0)
  losses          Int                @default(0)
  lossesByW       Int                @default(0)
  points          Int                @default(0)
  goalsFor        Int                @default(0)
  goalsAgainst    Int                @default(0)
  players         TournamentPlayer[]
  homeMatches     TournamentMatch[]  @relation("TournamentMatchHome")
  awayMatches     TournamentMatch[]  @relation("TournamentMatchAway")

  @@unique([tournamentId, enrolledGroupId])
  @@index([tournamentId])
  @@map("tournament_teams")
}

model TournamentPlayer {
  id           String         @id @default(uuid()) @db.Uuid
  teamId       String         @db.Uuid
  team         TournamentTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)
  name         String
  isGoalkeeper Boolean        @default(false)
  goals        Int            @default(0)
  goalsAgainst Int            @default(0)
  assists      Int            @default(0)
  /// Defensa férrea: recuperos de balón ante ataque rival.
  dfr          Int            @default(0)
  yellowCards  Int            @default(0)
  redCards     Int            @default(0)
  /// Solo para kind=elite_forge: el usuario real elegido por el lider para el roster.
  userId       String?        @db.Uuid
  user         User?          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([teamId])
  @@map("tournament_players")
}

model TournamentMatch {
  id           String                @id @default(uuid()) @db.Uuid
  tournamentId String                @db.Uuid
  tournament   Tournament            @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  roundLabel   String
  keyIndex     Int
  homeTeamId   String                @db.Uuid
  homeTeam     TournamentTeam        @relation("TournamentMatchHome", fields: [homeTeamId], references: [id], onDelete: Cascade)
  awayTeamId   String                @db.Uuid
  awayTeam     TournamentTeam        @relation("TournamentMatchAway", fields: [awayTeamId], references: [id], onDelete: Cascade)
  homeGoals    Int?
  awayGoals    Int?
  status       TournamentMatchStatus @default(scheduled)
  /// MatchPlayerStat[] tal cual (array de {playerId,teamId,goals,assists,goalsAgainst,dfr,yellowCards,redCards}).
  playerStats  Json                  @default("[]")
  startsAt     DateTime?
  endsAt       DateTime?
  courtNumber  Int                   @default(1)
  /// Cancha real asignada a ESTE partido. Para kind=private se copia de
  /// Tournament.venueId al generar. Para kind=elite_forge se asigna al azar entre
  /// canchas synthetic_grass disponibles en ese horario.
  venueId      String?               @db.Uuid
  venue        Venue?                @relation("TournamentMatchVenue", fields: [venueId], references: [id], onDelete: SetNull)
  /// Reserva real que este partido de torneo generó (Fase 7.1). Null si no se pudo reservar (choque de horario).
  reservation  Reservation?

  @@index([tournamentId])
  @@index([venueId])
  @@map("tournament_matches")
}

enum TournamentCourtSize {
  six_vs_six
  eight_vs_eight
  eleven_vs_eleven
}

enum TournamentFormat {
  groups_of_4
  round_robin
  brackets
}

enum TournamentStatus {
  draft
  registration
  active
  finished
}

enum TournamentMatchStatus {
  scheduled
  played
  walkover_home
  walkover_away
}

/**
 * Grupos de jugadores (Fase 2 del roadmap). Un usuario puede pertenecer a
 * varios grupos simultáneamente, sin límite. Ver docs/GRUPOS-PARTIDOS-RESERVAS-SPEC.md.
 */
model Group {
  id          String            @id @default(uuid()) @db.Uuid
  name        String
  photoBase64 String?           @db.Text
  creatorId   String            @db.Uuid
  creator     User              @relation("GroupCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  members     GroupMembership[]

  matchesAsOrigin   Match[] @relation("MatchOriginGroup")
  matchesAsOpponent Match[] @relation("MatchOpponentGroup")

  friendshipsAsA GroupFriendship[] @relation("GroupFriendshipA")
  friendshipsAsB GroupFriendship[] @relation("GroupFriendshipB")

  /// Inscripciones a Copa Elite Forge (Fase 7.2) — este grupo como equipo de un torneo.
  tournamentEnrollments TournamentTeam[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("groups")
}

enum GroupRole {
  creator
  admin
  member
}

model GroupMembership {
  id       String    @id @default(uuid()) @db.Uuid
  groupId  String    @db.Uuid
  group    Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId   String    @db.Uuid
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     GroupRole @default(member)
  joinedAt DateTime  @default(now())

  @@unique([groupId, userId])
  @@index([userId])
  @@map("group_memberships")
}

enum GroupFriendshipStatus {
  pending
  accepted
}

/**
 * Amistad entre dos grupos (Fase 6.5.3), requisito para retar en VS. El par
 * (groupAId, groupBId) se canonicaliza SIEMPRE por orden de string antes de
 * escribir o consultar — nunca confiar en el orden de llegada del cliente —
 * para que @@unique garantice una sola fila por par sin importar quién la pidió.
 */
model GroupFriendship {
  id                 String                @id @default(uuid()) @db.Uuid
  groupAId           String                @db.Uuid
  groupA             Group                 @relation("GroupFriendshipA", fields: [groupAId], references: [id], onDelete: Cascade)
  groupBId           String                @db.Uuid
  groupB             Group                 @relation("GroupFriendshipB", fields: [groupBId], references: [id], onDelete: Cascade)
  status             GroupFriendshipStatus @default(pending)
  requestedByGroupId String                @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([groupAId, groupBId])
  @@index([groupBId])
  @@map("group_friendships")
}

/**
 * Partidos (Fase 3). Reglas completas en docs/GRUPOS-PARTIDOS-RESERVAS-SPEC.md:
 * - internal: cualquier miembro de originGroupId lo crea; status inicial 'scheduled'.
 * - vs: solo creator/admin de originGroupId lo crea; status inicial 'pending_opponent'
 * hasta que creator/admin de opponentGroupId lo acepte o rechace.
 */
enum MatchType {
  internal
  vs
}

enum MatchStatus {
  draft
  pending_opponent
  scheduled
  played
  cancelled
}

model Match {
  id                String             @id @default(uuid()) @db.Uuid
  originGroupId     String             @db.Uuid
  originGroup       Group              @relation("MatchOriginGroup", fields: [originGroupId], references: [id], onDelete: Cascade)
  opponentGroupId   String?            @db.Uuid
  opponentGroup     Group?             @relation("MatchOpponentGroup", fields: [opponentGroupId], references: [id], onDelete: Cascade)
  type              MatchType
  format            String
  maxPlayers        Int
  status            MatchStatus        @default(scheduled)
  scheduledAt       DateTime?
  createdBy         String             @db.Uuid
  creator           User               @relation("MatchCreator", fields: [createdBy], references: [id], onDelete: Cascade)
  /// Vínculo real con la reserva que originó este partido (Fase 4). La FK vive en Reservation.matchId.
  reservation       Reservation?
  participants      MatchParticipant[]
  /// null hasta que el líder sortea equipos (Fase 6.5.4, solo partidos internal); se pisa en cada re-sorteo.
  teamsRandomizedAt DateTime?
  /// null hasta que ambos lados llegan a maxPlayers/2 (Fase 6.5.5, solo partidos vs). Nunca se vuelve a null.
  rosterConfirmedAt DateTime?
  /// Fase 6.5.5.1: flags de aviso push por umbral (6h/3h/1h/30min antes del kickoff, solo vs).
  /// Simples a propósito (no una tabla de log) — cada uno se pone en true una sola vez, nunca se resetea.
  alertSent6h       Boolean            @default(false)
  alertSent3h       Boolean            @default(false)
  alertSent1h       Boolean            @default(false)
  alertSent30m      Boolean            @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([originGroupId])
  @@index([opponentGroupId])
  @@map("matches")
}

enum MatchTeam {
  A
  B
}

/// Lado de un partido `vs` (Fase 6.5.5) — concepto distinto de MatchTeam, que es
/// el sorteo aleatorio interno de la 6.5.4 y no se toca acá.
enum MatchSide {
  origin
  opponent
}

model MatchParticipant {
  id          String     @id @default(uuid()) @db.Uuid
  matchId     String     @db.Uuid
  match       Match      @relation(fields: [matchId], references: [id], onDelete: Cascade)
  userId      String     @db.Uuid
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  confirmedAt DateTime   @default(now())
  /// null hasta el sorteo de equipos (Fase 6.5.4); se llena/pisa al randomizar.
  team        MatchTeam?
  /// solo se usa en partidos `vs`; null en partidos `internal`.
  side        MatchSide?

  @@unique([matchId, userId])
  @@index([userId])
  @@map("match_participants")
}

/**
 * Push tokens de Expo por usuario (Fase 6.5.5.1) — un usuario puede tener
 * varios (varios dispositivos). platform es un string libre ('ios'/'android')
 * en vez de enum: valor puramente informativo, no se filtra por él en ningún
 * lado todavía.
 */
model PushToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String
  platform  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, token])
  @@index([userId])
  @@map("push_tokens")
}

/**
 * Feed (Fase 5). Global entre todos los usuarios autenticados por decisión
 * de alcance explícita — no hay módulo de Amistades todavía en el MVP.
 * Ver docs/GRUPOS-PARTIDOS-RESERVAS-SPEC.md.
 */
enum PostMediaType {
  none
  image
  video
}

model Post {
  id        String        @id @default(uuid()) @db.Uuid
  authorId  String        @db.Uuid
  author    User          @relation("PostAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  content   String
  mediaType PostMediaType @default(none)
  mediaUrl  String?
  likes     PostLike[]
  comments  PostComment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([authorId])
  @@index([createdAt])
  @@map("posts")
}

model PostLike {
  id        String   @id @default(uuid()) @db.Uuid
  postId    String   @db.Uuid
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String   @db.Uuid
  user      User     @relation("PostLikeUser", fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([postId, userId])
  @@index([userId])
  @@map("post_likes")
}

model PostComment {
  id        String   @id @default(uuid()) @db.Uuid
  postId    String   @db.Uuid
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId  String   @db.Uuid
  author    User     @relation("PostCommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  content   String
  createdAt DateTime @default(now())

  @@index([postId])
  @@index([authorId])
  @@map("post_comments")
}

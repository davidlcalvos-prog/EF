generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Role {
  id          Int     @id @default(autoincrement())
  name        String  @unique
  description String?

  users User[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("roles")
}

model User {
  id           String  @id @default(uuid()) @db.Uuid
  firstname    String
  lastname     String
  email        String  @unique
  passwordHash String
  estado       Boolean @default(true)

  roleId Int
  role   Role @relation(fields: [roleId], references: [id])

  profile             Profile?
  ownedVenues         Venue[]              @relation("VenueOwner")
  reservations        Reservation[]        @relation("ReservationUser")
  playerStats         PlayerStats?
  physicalTestResults PhysicalTestResult[]
  psychAssessments    PsychAssessment[]
  createdGroups       Group[]              @relation("GroupCreator")
  groupMemberships    GroupMembership[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Profile {
  id     String @id @default(uuid()) @db.Uuid
  userId String @unique @db.Uuid
  user   User   @relation(fields: [userId], references: [id])

  alias     String    @unique
  birthDate DateTime?

  height Float?
  weight Float?

  /**
   * Una de las 7 posiciones de `PlayerPositionId` (mobile: suggestPlayerPosition.ts). Elegida por el jugador, distinta de la sugerida.
   */
  favoritePosition String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("profiles")
}

/**
 * Snapshot vigente de las 6 estadísticas del jugador (mobile: mockPlayerProfile.ts StatKey).
 * Se recalcula al guardar cada PhysicalTestResult.
 */
model PlayerStats {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  attack    Int      @default(0)
  defense   Int      @default(0)
  endurance Int      @default(0)
  speed     Int      @default(0)
  passes    Int      @default(0)
  dribbling Int      @default(0)
  updatedAt DateTime @updatedAt

  @@map("player_stats")
}

/**
 * Historial de resultados de tests físicos (uno por mes calendario por testId, aplicado server-side).
 * testId ∈ 'attackShots16m' | 'defenseControl' | 'beepTest' | 'sprint30m' | 'loughboroughPass' | 'illinoisAgility'.
 */
model PhysicalTestResult {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  testId      String
  rawData     Json
  score       Int
  completedAt DateTime @default(now())

  @@index([userId, testId])
  @@map("physical_test_results")
}

/**
 * Historial de evaluaciones psicológicas (mobile: psychologicalTest.ts).
 * traits: Record<PsychTraitKey, number> (organizer, directness, discipline, creativity, competitiveness).
 */
model PsychAssessment {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @db.Uuid
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  answers       Json
  teamworkScore Int
  onFieldScore  Int
  overallScore  Int
  traits        Json
  completedAt   DateTime @default(now())

  @@index([userId])
  @@map("psych_assessments")
}

enum ReservationStatus {
  pending
  confirmed
  cancelled
}

model Venue {
  id                String        @id @default(uuid()) @db.Uuid
  ownerId           String        @db.Uuid
  owner             User          @relation("VenueOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  name              String
  address           String?
  pricePerHourCents Int           @default(0)
  availability      Json          @default("{}")
  reservations      Reservation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
  @@map("venues")
}

model Reservation {
  id        String            @id @default(uuid()) @db.Uuid
  userId    String            @db.Uuid
  user      User              @relation("ReservationUser", fields: [userId], references: [id], onDelete: Cascade)
  venueId   String?           @db.Uuid
  venue     Venue?            @relation(fields: [venueId], references: [id], onDelete: SetNull)
  venueName String
  startsAt  DateTime
  endsAt    DateTime
  status    ReservationStatus @default(pending)
  notes     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([venueId])
  @@index([userId])
  @@map("reservations")
}

/**
 * Grupos de jugadores (Fase 2 del roadmap). Un usuario puede pertenecer a
 * varios grupos simultáneamente, sin límite. Ver docs/GRUPOS-PARTIDOS-RESERVAS-SPEC.md.
 */
model Group {
  id        String            @id @default(uuid()) @db.Uuid
  name      String
  creatorId String            @db.Uuid
  creator   User              @relation("GroupCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  members   GroupMembership[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("groups")
}

enum GroupRole {
  creator
  admin
  member
}

model GroupMembership {
  id       String    @id @default(uuid()) @db.Uuid
  groupId  String    @db.Uuid
  group    Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId   String    @db.Uuid
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     GroupRole @default(member)
  joinedAt DateTime  @default(now())

  @@unique([groupId, userId])
  @@index([userId])
  @@map("group_memberships")
}

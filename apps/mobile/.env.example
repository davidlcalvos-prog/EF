# Local: copia como apps/mobile/.env.local

# IP LAN de tu PC en WiFi, usada solo al correr la app en un dispositivo físico
# (el emulador/simulador y el navegador no la necesitan). Cambia cada vez que
# te conectas desde otra red. Averíguala con `ipconfig` (Windows) o `ifconfig`/`ip a`.
EXPO_PUBLIC_DEV_LAN_HOST=192.168.x.x

{
  "cli": {
    "version": ">= 3.15.1"
  },
  "build": {
    "development": {
      "extends": "production",
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "gradleCommand": ":app:assembleDebug",
        "buildType": "apk"
      },
      "ios": {
        "buildConfiguration": "Debug",
        "simulator": true
      }
    },
    "development:device": {
      "extends": "development",
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "buildConfiguration": "Debug",
        "simulator": false
      }
    },
    "preview": {
      "extends": "production",
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.eliteforge.tech/api/",
        "EXPO_PUBLIC_SIGN_UP_URL": "https://eliteforge.tech/auth/sign-up"
      },
      "ios": { "simulator": true },
      "android": { "buildType": "apk" }
    },
    "preview:device": {
      "extends": "preview",
      "ios": { "simulator": false }
    },
    "production": {
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.eliteforge.tech/api/",
        "EXPO_PUBLIC_SIGN_UP_URL": "https://eliteforge.tech/auth/sign-up"
      }
    }
  },
  "submit": {
    "production": {}
  }
}

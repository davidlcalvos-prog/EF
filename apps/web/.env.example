# Local: copia como apps/web/.env.local

# Backend NestJS (jugadores + admin)
API_GATEWAY_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=/api
NEXT_PUBLIC_SITE_URL=http://localhost:5173

# -----------------------------------------------------------------------------
# Producción (Hostinger): configura estos valores en hPanel → Environment
# variables y redeploy. API_GATEWAY_URL se usa SOLO del lado servidor
# (rewrites de next.config.mjs + lib/api/server-client.ts) — nunca llega al
# bundle del cliente.
#
# API_GATEWAY_URL=https://api.eliteforge.app
# NEXT_PUBLIC_API_URL=/api
# NEXT_PUBLIC_SITE_URL=https://eliteforge.app
# -----------------------------------------------------------------------------

# syntax=docker/dockerfile:1

ARG NODE_VERSION=22

# -----------------------------------------------------------------------------
# Builder — instala deps del workspace @ef/backend y compila venues-service
# -----------------------------------------------------------------------------
FROM node:${NODE_VERSION}-alpine AS builder

RUN apk add --no-cache python3 make g++

WORKDIR /app

# Manifests del monorepo (npm ci exige lockfile + todos los workspaces declarados)
COPY package.json package-lock.json ./
COPY apps/backend/package.json apps/backend/package.json
COPY apps/mobile/package.json apps/mobile/package.json
COPY apps/web/package.json apps/web/package.json

# Prisma ANTES del npm ci: el postinstall de apps/backend corre `prisma generate`
# y necesita prisma.config.ts + prisma/schema.prisma presentes (sin esto, npm ci falla).
COPY apps/backend/prisma.config.ts apps/backend/prisma.config.ts
COPY apps/backend/prisma apps/backend/prisma

RUN npm ci --workspace=@ef/backend --include-workspace-root

# Código fuente del backend NestJS (apps/ + libs/ internos)
COPY apps/backend/nest-cli.json apps/backend/tsconfig.build.json apps/backend/tsconfig.json ./apps/backend/
COPY apps/backend/apps ./apps/backend/apps
COPY apps/backend/libs ./apps/backend/libs

WORKDIR /app/apps/backend
RUN npm run build:venues

# -----------------------------------------------------------------------------
# Production — deps de producción + cliente Prisma generado + artefacto compilado
# -----------------------------------------------------------------------------
FROM node:${NODE_VERSION}-alpine AS production

RUN apk add --no-cache python3 make g++

WORKDIR /app

COPY package.json package-lock.json ./
COPY apps/backend/package.json apps/backend/package.json
COPY apps/mobile/package.json apps/mobile/package.json
COPY apps/web/package.json apps/web/package.json

# Igual que en builder: el postinstall (prisma generate) necesita schema+config.
# La CLI de prisma (dependencia normal, no dev) queda en la imagen final para
# `prisma migrate deploy`, y las migraciones viajan dentro de prisma/.
COPY apps/backend/prisma.config.ts apps/backend/prisma.config.ts
COPY apps/backend/prisma apps/backend/prisma

ENV NODE_ENV=production

RUN npm ci --workspace=@ef/backend --include-workspace-root --omit=dev \
  && apk del python3 make g++

COPY --from=builder /app/apps/backend/dist ./apps/backend/dist

WORKDIR /app/apps/backend

EXPOSE 3003

CMD ["node", "dist/apps/venues-service/apps/venues-service/src/main.js"]

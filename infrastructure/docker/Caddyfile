# Caddy termina TLS (certificado automático de Let's Encrypt) y proxya al
# gateway en la red interna del compose. API_DOMAIN viene del .env.production
# (producción real: api.eliteforge.tech). El registro DNS A del subdominio debe apuntar a la
# IP del VPS ANTES de levantar, o la emisión del certificado falla.
{$API_DOMAIN} {
	reverse_proxy api-gateway:3000
}

# Fase W.5: la web Next.js (standalone) también vive en el compose. WEB_DOMAIN
# puede traer varios hostnames separados por espacio (eliteforge.tech
# www.eliteforge.tech): el placeholder {$WEB_DOMAIN} se sustituye ANTES de
# tokenizar, así que Caddy los interpreta como dos direcciones del mismo bloque.
{$WEB_DOMAIN} {
	reverse_proxy web:3000
}
